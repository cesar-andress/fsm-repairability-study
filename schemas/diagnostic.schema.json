{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostic.schema.json",
  "title": "OracleDiagnostic",
  "description": "Deterministic diagnostic artefact from evaluating one FSM candidate against one oracle suite. Separates evaluation from model-based repair generation; no LLM fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "scoring_summary",
    "failure_categories",
    "failed_checks",
    "reproducibility"
  ],
  "properties": {
    "identity": { "$ref": "#/$defs/identity" },
    "scoring_summary": { "$ref": "#/$defs/scoring_summary" },
    "failure_categories": { "$ref": "#/$defs/failure_categories" },
    "failed_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/failed_check" },
      "description": "Empty when all checks pass (bpr == 1.0). Field richness constrained by diagnostic_level."
    },
    "localization": { "$ref": "#/$defs/localization" },
    "repair_hints": { "$ref": "#/$defs/repair_hints" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity": {
            "properties": { "diagnostic_level": { "const": "binary" } },
            "required": ["diagnostic_level"]
          }
        },
        "required": ["identity"]
      },
      "then": {
        "not": { "required": ["localization"] },
        "properties": {
          "failed_checks": {
            "items": {
              "not": {
                "anyOf": [
                  { "required": ["input_trace"] },
                  { "required": ["expected"] },
                  { "required": ["observed"] },
                  { "required": ["expected_final_state"] },
                  { "required": ["observed_final_state"] }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity": {
            "properties": { "diagnostic_level": { "const": "trace" } },
            "required": ["diagnostic_level"]
          }
        },
        "required": ["identity"]
      },
      "then": {
        "not": { "required": ["localization"] }
      }
    },
    {
      "if": {
        "properties": {
          "identity": {
            "properties": { "diagnostic_level": { "const": "localized" } },
            "required": ["diagnostic_level"]
          }
        },
        "required": ["identity"]
      },
      "then": {
        "required": ["localization"]
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "iso_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*\\.[a-zA-Z0-9]+$",
      "minLength": 5,
      "maxLength": 512
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bpr": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "diagnostic_level": {
      "type": "string",
      "enum": ["binary", "trace", "localized"],
      "description": "Feedback exposure: binary | trace | localized."
    },
    "failure_type": {
      "type": "string",
      "enum": [
        "trace_mismatch",
        "undefined_transition",
        "final_state_mismatch",
        "unexpected_transition",
        "unexpected_acceptance",
        "unexpected_rejection",
        "nondeterminism",
        "nondeterminism_conflict",
        "simulation_error",
        "invalid_check_spec",
        "fsm_integrity_error",
        "unsupported_check_type",
        "other"
      ]
    },
    "oracle_type": {
      "type": "string",
      "enum": ["trace", "final_state", "rejected_event", "unknown"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_id",
        "schema_version",
        "case_id",
        "run_id",
        "iteration_index",
        "diagnostic_level"
      ],
      "properties": {
        "diagnostic_id": {
          "$ref": "#/$defs/slug",
          "description": "Unique id for this diagnostic artefact."
        },
        "schema_version": {
          "$ref": "#/$defs/semver",
          "description": "Semantic version of diagnostic.schema.json (current: 2.0.0)."
        },
        "case_id": { "$ref": "#/$defs/slug" },
        "run_id": { "$ref": "#/$defs/slug" },
        "iteration_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Repair iteration index (0 at entry)."
        },
        "diagnostic_level": { "$ref": "#/$defs/diagnostic_level" }
      }
    },
    "scoring_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_suite_id",
        "total_checks",
        "passed_checks",
        "failed_checks",
        "bpr"
      ],
      "properties": {
        "oracle_suite_id": { "$ref": "#/$defs/slug" },
        "total_checks": { "type": "integer", "minimum": 0 },
        "passed_checks": { "type": "integer", "minimum": 0 },
        "failed_checks": { "type": "integer", "minimum": 0 },
        "bpr": { "$ref": "#/$defs/bpr" }
      },
      "description": "When total_checks > 0, bpr must equal passed_checks / total_checks (enforced in tests)."
    },
    "failure_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive_path_failures",
        "rejection_failures",
        "final_state_failures",
        "trace_failures",
        "nondeterminism_failures",
        "simulation_failures"
      ],
      "properties": {
        "positive_path_failures": {
          "type": "integer",
          "minimum": 0,
          "description": "trace + final_state failures combined."
        },
        "rejection_failures": {
          "type": "integer",
          "minimum": 0,
          "description": "rejected_event failures."
        },
        "final_state_failures": {
          "type": "integer",
          "minimum": 0
        },
        "trace_failures": {
          "type": "integer",
          "minimum": 0
        },
        "nondeterminism_failures": {
          "type": "integer",
          "minimum": 0
        },
        "simulation_failures": {
          "type": "integer",
          "minimum": 0,
          "description": "Execution or integrity errors before oracle comparison."
        }
      }
    },
    "input_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "items": { "type": "string" }
        },
        "from_state": {
          "type": "string",
          "description": "Starting state for rejected_event checks."
        }
      }
    },
    "failed_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "oracle_type", "failure_type"],
      "properties": {
        "check_id": { "$ref": "#/$defs/slug" },
        "oracle_type": { "$ref": "#/$defs/oracle_type" },
        "failure_type": { "$ref": "#/$defs/failure_type" },
        "input_trace": { "$ref": "#/$defs/input_trace" },
        "expected": {
          "type": "object",
          "description": "Expected witness (trace level+)."
        },
        "observed": {
          "type": "object",
          "description": "Observed witness (trace level+)."
        },
        "expected_final_state": {
          "type": ["string", "null"]
        },
        "observed_final_state": {
          "type": ["string", "null"]
        },
        "diagnostic_hint": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "transition_triple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "event", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suspicious_states": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "suspicious_transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition_triple" }
        },
        "missing_transition_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition_triple" }
        },
        "extra_transition_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition_triple" }
        }
      },
      "description": "Required when diagnostic_level is localized; forbidden for binary and trace."
    },
    "repair_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suggested_patch_operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op"],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "add_transition",
                  "remove_transition",
                  "update_transition",
                  "add_state",
                  "remove_state",
                  "rename_state",
                  "change_initial_state"
                ]
              },
              "from": { "type": "string" },
              "event": { "type": "string" },
              "to": { "type": "string" },
              "old_to": { "type": "string" },
              "new_to": { "type": "string" },
              "state": { "type": "string" },
              "note": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "suggested_targets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "maxLength": 4000,
          "description": "Rule-based explanation; not model-generated prose."
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fsm_path",
        "oracle_suite_path",
        "scorer_version",
        "generated_at",
        "checksums"
      ],
      "properties": {
        "source_fsm_path": { "$ref": "#/$defs/relative_path" },
        "oracle_suite_path": { "$ref": "#/$defs/relative_path" },
        "scorer_version": { "$ref": "#/$defs/semver" },
        "generated_at": { "$ref": "#/$defs/iso_timestamp" },
        "checksums": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score_report_sha256"],
          "properties": {
            "score_report_sha256": { "$ref": "#/$defs/sha256_hex" },
            "source_fsm_sha256": { "$ref": "#/$defs/sha256_hex" },
            "oracle_suite_sha256": { "$ref": "#/$defs/sha256_hex" }
          }
        }
      }
    }
  }
}
