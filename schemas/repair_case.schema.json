{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair_case.schema.json",
  "title": "RepairCase",
  "description": "Frozen experimental unit: structurally valid, behaviourally incorrect FSM with oracles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "initial_fsm",
    "oracle_suite_ids",
    "structurally_valid",
    "behaviourally_correct"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0-placeholder"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "task_spec_ref": {
      "type": "string",
      "description": "Reference to behavioural task specification (file id or URI)."
    },
    "initial_fsm": {
      "description": "Embedded FSM or path relative to case directory.",
      "oneOf": [
        { "$ref": "fsm.schema.json" },
        { "type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.json$" }
      ]
    },
    "oracle_suite_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "structurally_valid": {
      "type": "boolean",
      "const": true,
      "description": "Must be true for inclusion in repairability sample."
    },
    "behaviourally_correct": {
      "type": "boolean",
      "const": false,
      "description": "Must be false at study entry."
    },
    "generation_summary": {
      "type": "object",
      "description": "Summarized provenance; no requirement to include raw LLM logs.",
      "properties": {
        "model_label": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
