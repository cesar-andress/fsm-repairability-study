{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair_case.schema.json",
  "title": "RepairCase",
  "description": "Fundamental experimental unit (one observation) for the behavioural repairability study. Designed for large corpora, oracle separation, full repair history, and Zenodo archival.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "inputs",
    "baseline",
    "oracles",
    "diagnostics",
    "repair_history",
    "final_outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of this schema (current: 2.0.0)."
    },
    "identity": { "$ref": "#/$defs/identity" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "oracles": { "$ref": "#/$defs/oracles" },
    "diagnostics": { "$ref": "#/$defs/diagnostics" },
    "repair_history": { "$ref": "#/$defs/repair_history" },
    "final_outcome": { "$ref": "#/$defs/final_outcome" },
    "admission": {
      "$ref": "#/$defs/admission",
      "description": "Eligibility gates frozen at case construction."
    },
    "archival": {
      "$ref": "#/$defs/archival",
      "description": "Zenodo-oriented integrity and provenance metadata."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "final_outcome": {
            "type": "object",
            "properties": { "repair_status": { "const": "not_started" } },
            "required": ["repair_status"]
          }
        }
      },
      "then": {
        "properties": {
          "repair_history": {
            "type": "object",
            "properties": {
              "iterations": { "maxItems": 0 },
              "applied_patches": { "maxItems": 0 },
              "intermediate_bpr": { "maxItems": 1 }
            }
          },
          "final_outcome": {
            "type": "object",
            "properties": {
              "final_bpr": { "type": "null" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*\\.json$",
      "minLength": 5,
      "maxLength": 512
    },
    "bpr": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fsm_ref": {
      "description": "Inline FSM (small fixtures) or relative path (recommended at scale).",
      "oneOf": [
        { "$ref": "fsm.schema.json" },
        { "$ref": "#/$defs/relative_path" }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "system_id", "campaign_id"],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/slug",
          "description": "Globally unique case identifier within the study."
        },
        "system_id": {
          "$ref": "#/$defs/slug",
          "description": "Behavioural system or task family (stratification, not engine id)."
        },
        "campaign_id": {
          "$ref": "#/$defs/slug",
          "description": "Generation or export batch for corpus partitioning and manifest grouping."
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_text", "candidate_fsm", "reference_fsm"],
      "properties": {
        "requirement_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000,
          "description": "Frozen natural-language behavioural requirement."
        },
        "candidate_fsm": {
          "$ref": "#/$defs/fsm_ref",
          "description": "Initial candidate M_0 (structurally valid, behaviourally incorrect at entry)."
        },
        "reference_fsm": {
          "$ref": "#/$defs/fsm_ref",
          "description": "Reference (gold) FSM for structural comparison and task grounding."
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_bpr", "initial_component_metrics"],
      "properties": {
        "initial_bpr": {
          "$ref": "#/$defs/bpr",
          "description": "BPR(M_0, O_validation) at study entry."
        },
        "initial_component_metrics": {
          "$ref": "#/$defs/component_metrics",
          "description": "Per-check outcomes on validation oracles at entry."
        }
      }
    },
    "oracles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_oracles", "validation_oracles"],
      "properties": {
        "feedback_oracles": {
          "$ref": "#/$defs/oracle_binding",
          "description": "Oracles permitted to inform repair-time feedback (may be a subset)."
        },
        "validation_oracles": {
          "$ref": "#/$defs/oracle_binding",
          "description": "Authoritative oracles for BPR and published conclusions."
        }
      }
    },
    "oracle_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id"],
      "properties": {
        "suite_id": {
          "$ref": "#/$defs/slug",
          "description": "Key under datasets/oracle_suites/<suite_id>.json."
        },
        "suite_path": {
          "$ref": "#/$defs/relative_path",
          "description": "Optional relative path override when suite is case-local."
        },
        "check_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" },
          "uniqueItems": true,
          "description": "Explicit check subset; omit for full suite membership."
        }
      }
    },
    "component_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "checks"],
      "properties": {
        "suite_id": { "$ref": "#/$defs/slug" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check_outcome" }
        },
        "passed_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 1 }
      }
    },
    "check_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "passed"],
      "properties": {
        "check_id": { "$ref": "#/$defs/slug" },
        "passed": { "type": "boolean" },
        "check_type": { "type": "string" },
        "summary": { "type": "string", "maxLength": 1000 }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_transitions", "extra_transitions", "failure_summary"],
      "properties": {
        "missing_transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition_triple" }
        },
        "extra_transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition_triple" }
        },
        "failure_summary": {
          "type": "string",
          "maxLength": 4000,
          "description": "Frozen human-readable summary of entry failures (not live-generated)."
        }
      }
    },
    "transition_triple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "event", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "repair_history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "applied_patches", "intermediate_bpr"],
      "properties": {
        "iterations": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/iteration_record" }
        },
        "applied_patches": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/relative_path" },
          "description": "Ordered patch artefact paths (parallel to successful patch applications)."
        },
        "intermediate_bpr": {
          "type": "array",
          "minItems": 1,
          "maxItems": 129,
          "items": { "$ref": "#/$defs/bpr" },
          "description": "BPR on validation oracles after each milestone; index 0 = initial_bpr."
        }
      }
    },
    "iteration_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration_index",
        "repair_condition",
        "bpr_after",
        "validation_passed_all"
      ],
      "properties": {
        "iteration_index": { "type": "integer", "minimum": 0 },
        "repair_condition": {
          "type": "string",
          "enum": [
            "baseline_no_repair",
            "baseline_full_regeneration",
            "patch_binary_feedback",
            "patch_trace_feedback",
            "patch_localized_feedback"
          ]
        },
        "run_id": { "$ref": "#/$defs/slug" },
        "bpr_before": { "$ref": "#/$defs/bpr" },
        "bpr_after": { "$ref": "#/$defs/bpr" },
        "validation_passed_all": {
          "type": "boolean",
          "description": "All validation_oracles checks pass after this iteration."
        },
        "feedback_checks_used": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" },
          "description": "Which feedback oracle checks informed this iteration."
        },
        "patch_path": { "$ref": "#/$defs/relative_path" },
        "candidate_fsm_after": { "$ref": "#/$defs/fsm_ref" },
        "regression": {
          "type": "boolean",
          "description": "True if bpr_after < bpr_before."
        },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "final_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_bpr",
        "repair_status",
        "regression_detected",
        "overfitting_detected"
      ],
      "properties": {
        "final_bpr": {
          "oneOf": [{ "$ref": "#/$defs/bpr" }, { "type": "null" }]
        },
        "repair_status": {
          "type": "string",
          "enum": [
            "not_started",
            "success",
            "partial",
            "failed",
            "budget_exhausted",
            "aborted",
            "regression_terminal"
          ]
        },
        "regression_detected": {
          "type": "boolean",
          "description": "True if any iteration decreased BPR vs. prior milestone."
        },
        "overfitting_detected": {
          "type": "boolean",
          "description": "True if feedback_oracle gains did not generalize to validation_oracles (see repairability_definition.md)."
        },
        "final_component_metrics": {
          "$ref": "#/$defs/component_metrics",
          "description": "Per-check outcomes on validation oracles at termination."
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structurally_valid": { "type": "boolean", "const": true },
        "eligible_for_repair_study": { "type": "boolean", "const": true },
        "initial_bpr_below_one": { "type": "boolean", "const": true }
      }
    },
    "archival": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "frozen_at": { "type": "string", "format": "date-time" },
        "zenodo_bundle": { "type": "string" },
        "checksums": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_file_sha256": { "$ref": "#/$defs/sha256" },
            "candidate_fsm_sha256": { "$ref": "#/$defs/sha256" },
            "reference_fsm_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "candidate_origin": {
              "type": "string",
              "enum": ["synthetic", "exported_generation", "manual", "other"]
            },
            "notes": { "type": "string", "maxLength": 2000 }
          }
        }
      }
    }
  }
}
